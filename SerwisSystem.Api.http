Authorization: Bearer {{token}}


### Edit user permissions 
# ===========================
# All of the permissions:
#         "ReadRepairs",
#         "TakeRepairs",
#         "EditRepairs",
#         "DeleteRepairs",
#         "ReadUsers",
#         "EditUsers",
#         "DeleteUsers",
#         "GrantUsers",
#         "DischargeUsers"
# ===========================
PUT {{SerwisSystem_Api_HostAddress}}/api/users/grant/13
Content-Type: application/json
Authorization: Bearer {{token}}
{
    "permissionsGranted": [
       "GrantUsers"
    ],
    "permissionsRevoked": [
        "ReadRepairs",
        "TakeRepairs",
        "EditRepairs",
        "DeleteRepairs",
        "ReadUsers",
        "EditUsers",
        "DeleteUsers",
        "DischargeUsers"
    ]
}
###

