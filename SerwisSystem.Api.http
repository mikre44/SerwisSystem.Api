@SerwisSystem_Api_HostAddress = http://localhost:5000

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..KU0VWXgOQhGu2pCsVoXSjY68DwrctI8vEx88j74XtMA


###=====================================List of Repair requests=====================================

### List of all repairs
GET {{SerwisSystem_Api_HostAddress}}/api/repairs
Accept: application/json
Authorization: Bearer {{token}}


### Append new repair
POST {{SerwisSystem_Api_HostAddress}}/api/repairs
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "serialNumber": 12345,
    "status": 0,
    "product": "iPhone 15",
    "description": "Broken screen",
    "name": "Jan",
    "surname": "Kowalski",
    "phoneNumber": "123456789",
    "email": "jan@example.com",
    "address": "Example 1",
    "nip": 1234567890
}


### assign the user to repair with id ...

POST {{SerwisSystem_Api_HostAddress}}/api/repairs/9/take
Accept: application/json
Authorization: Bearer {{token}}


### complete the repair with id ...
POST {{SerwisSystem_Api_HostAddress}}/api/repairs/9/complete
Accept: application/json
Authorization: Bearer {{token}}


### cancel the repair with id ...
POST {{SerwisSystem_Api_HostAddress}}/api/repairs/9/cancel
Accept: application/json
Authorization: Bearer {{token}}


### return the repair with id ...
POST {{SerwisSystem_Api_HostAddress}}/api/repairs/9/return
Accept: application/json
Authorization: Bearer {{token}}


### Update repair with id ...
PUT {{SerwisSystem_Api_HostAddress}}/api/repairs/11
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "serialNumber": 23456,
    "status": 2,
    "product": "iPhone 25",
    "description": "Screen completely shattered",
    "name": "Jan",
    "surname": "Kowalski",
    "phoneNumber": "123456789",
    "email": "jan@example.com",
    "address": "Example 2",
    "nip": 1234567890
}

### Delete repair with id ...
DELETE {{SerwisSystem_Api_HostAddress}}/api/repairs/3
Accept: application/json
Authorization: Bearer {{token}}


