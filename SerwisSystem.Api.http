@SerwisSystem_Api_HostAddress = http://localhost:5000

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..L9pYKS1-8h6DZ0Qr3kP_r0_l0uIiVwPWiHbrfAkV5kc

### List of all repairs
GET {{SerwisSystem_Api_HostAddress}}/api/repairs
Accept: application/json
Authorization: Bearer {{token}}


### Append new repair
POST {{SerwisSystem_Api_HostAddress}}/api/repairs
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "serialNumber": 12345,
    "status": 0,
    "product": "iPhone 15",
    "description": "Broken screen",
    "name": "Jan",
    "surname": "Kowalski",
    "phoneNumber": "123456789",
    "email": "jan@example.com",
    "address": "Example 1",
    "nip": 1234567890
}

### Update repair with id ... with user id ...

POST {{SerwisSystem_Api_HostAddress}}/api/repairs/9/take
Accept: application/json
Authorization: Bearer {{token}}


### Remove userId from repair with id ...\
POST {{SerwisSystem_Api_HostAddress}}/api/repairs/2/removeUserId
Accept: application/json
Authorization: Bearer {{token}}


### Update repair with id ...
PUT {{SerwisSystem_Api_HostAddress}}/api/repairs/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "serialNumber": 23456,
    "status": 2,
    "product": "iPhone 25",
    "description": "Screen completely shattered",
    "name": "Jan",
    "surname": "Kowalski",
    "phoneNumber": "123456789",
    "email": "jan@example.com",
    "address": "Example 2",
    "nip": 1234567890
}

### Delete repair with id ...
DELETE {{SerwisSystem_Api_HostAddress}}/api/repairs/3
Accept: application/json
Authorization: Bearer {{token}}


###-----------------------------------------------------------------list of user requests-------------------------------------------------------------

### List of all users
GET {{SerwisSystem_Api_HostAddress}}/api/users
Accept: application/json
Authorization: Bearer {{token}}



### Create user - to be changed
POST {{SerwisSystem_Api_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Username": "jan",
    "PasswordHash": "xyzxyz",
    "email": "jan@example.com"
}

### Update user - same
PUT {{SerwisSystem_Api_HostAddress}}/api/users/2
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Username": "naj",
    "PasswordHash": "abcanc",
    "email": "jan@example.com"
}
### Delete user - here for now
DELETE {{SerwisSystem_Api_HostAddress}}/api/users/4
Accept: application/json
Authorization: Bearer {{token}}

### Edit user permissions
PUT {{SerwisSystem_Api_HostAddress}}/api/users/grant/13
Content-Type: application/json
Authorization: Bearer {{token}}
{
    "permissionsGranted": [
        "ReadRepairs",
        "TakeRepair",
        "EditRepair"
    ],
    "permissionsRevoked": [
        "DeleteRepair",
        "GrantUser"
    ]
}

